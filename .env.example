# Environment Variables Example
#
# Copie este arquivo para `.env` e preencha os valores. O `.env` está no
# .gitignore e NUNCA deve ser comitado.
#
# O pipeline determinístico (leitura do OCR, grounding, invariantes algébricos e
# validação de schema) roda sem nenhuma variável definida, via `--offline`.
# Apenas o extrator semântico exige a chave da DeepSeek.

# --- DeepSeek: extração semântica dos eventos (lidas por src/config.py) ---
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_TEMPERATURE=0.0
DEEPSEEK_MAX_RETRIES=2
DEEPSEEK_TIMEOUT_S=120

# --- Orçamento de contexto do pré-filtro ---
CONTEXT_MAX_CHARS_PER_PAGE=6000

# --- Reservadas / não lidas pelo pipeline atual ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
INPI_API_TOKEN=
LOG_LEVEL=INFO
